# API Key Validator 配置模板
# 复制为 config.yml 后填入真实信息
# cp config.yml.example config.yml

providers:
  - name: "示例 Provider"
    type: openai              # openai 或 anthropic
    source_url: ""            # 获取 API Key 的网址（可选）
    base_url: "https://api.example.com/v1"
    api_keys:                 # 支持多个 key，每行一个
      - "sk-xxxxxxxx"
      - "sk-yyyyyyyy"
    models: []                # 点击「📡 获取模型」自动填充
    selected_model: ""        # 获取模型后自动选择，也可手动输入
    timeout: 60               # 请求超时（秒），可选 30/60/120/300

  - name: "单 Key 示例"
    type: openai
    base_url: "https://api.openai.com/v1"
    api_keys:
      - "«redacted:sk-…»"
    models: []
    selected_model: ""
    timeout: 60

stream: false
